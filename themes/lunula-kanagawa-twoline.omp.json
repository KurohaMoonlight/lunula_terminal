{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "sumiInk0": "#16161D",
    "sumiInk1": "#181820",
    "sumiInk3": "#1F1F28",
    "sumiInk4": "#2A2A37",
    "sumiInk5": "#363646",
    "waveBlue1": "#223249",
    "waveBlue2": "#2D4F67",
    "crystalBlue": "#7E9CD8",
    "springBlue": "#7FB4CA",
    "waveAqua1": "#6A9589",
    "waveAqua2": "#7AA89F",
    "springGreen": "#98BB6C",
    "autumnGreen": "#76946A",
    "boatYellow1": "#C0A36E",
    "boatYellow2": "#E6C384",
    "autumnRed": "#C34043",
    "samuraiRed": "#E82424",
    "sakuraPink": "#D27E99",
    "fujiWhite": "#DCD7BA",
    "oldWhite": "#C8C093",
    "fujiGray": "#727169"
  },
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "background": "p:waveBlue2",
          "foreground": "p:springBlue",
          "template": "🌙 {{ if .WSL }}WSL{{ else }}{{ .Icon }}{{ end }} "
        },
        {
          "type": "session",
          "style": "diamond",
          "powerline_symbol": "\ue0b4",
          "background": "p:waveBlue2",
          "foreground": "p:fujiWhite",
          "template": "{{ .UserName }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "\ue0b4",
          "background": "p:waveBlue1",
          "foreground": "p:oldWhite",
          "options": {
            "folder_icon": "..\ue5fe..",
            "home_icon": "~",
            "style": "agnoster_short"
          },
          "template": " {{ .Path }} "
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "\ue0b4",
          "background": "p:autumnGreen",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:boatYellow1{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:autumnRed{{ end }}",
            "{{ if gt .Behind 0 }}p:samuraiRed{{ end }}"
          ],
          "foreground": "p:sumiInk0",
          "options": {
            "branch_icon": "\ue725 ",
            "cherry_pick_icon": "\ue29b ",
            "commit_icon": "\uf417 ",
            "merge_icon": "\ue727 ",
            "no_commits_icon": "\uf0c3 ",
            "rebase_icon": "\ue728 ",
            "revert_icon": "\uf0e2 ",
            "tag_icon": "\uf412 "
          },
          "template": " {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} ✚{{ end }} "
        },
        {
          "type": "executiontime",
          "style": "diamond",
          "trailing_diamond": "\ue0b4",
          "background": "p:sumiInk4",
          "foreground": "p:boatYellow2",
          "options": {
            "threshold": 500,
            "style": "round"
          },
          "template": " 󱦟 {{ .FormattedMs }} "
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:springBlue",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:autumnRed{{ end }}"
          ],
          "template": "🌙 ❯"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 4
}
